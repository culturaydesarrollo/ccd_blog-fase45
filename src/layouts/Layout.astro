---
import { ClientRouter } from 'astro:transitions';
import BlogNavbar from '../components/BlogNavbar.astro';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	author?: string;
	publishedDate?: Date;
	image?: string;
	imageAlt?: string;
	/** Evita que la página se indexe (por ejemplo, la 404). */
	noindex?: boolean;
}

const { title, description, type = 'website', author, publishedDate, image, imageAlt, noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<title>{title}</title>
		<SeoHead
			title={title}
			description={description}
			type={type}
			author={author}
			publishedDate={publishedDate}
			image={image}
			imageAlt={imageAlt}
			noindex={noindex}
		/>
		<!--
		  La verificación de Search Console se hace con el archivo
		  public/googleaf6b69fe8ec517ad.html, no con etiqueta meta.
		  Estuvo aquí un tiempo una etiqueta con el token del apex
		  (17GfBB6sy7B…), que es de otra propiedad y nunca pudo
		  verificar esta: solo estorba, por eso se quitó.
		  El archivo no se borra: Google lo vuelve a comprobar.
		-->
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<!--
		  View Transitions (opción F). El router sustituye el <html> completo en
		  cada navegación, lo que descarta data-theme y data-text-size. Este
		  fragmento se ejecuta antes del swap (astro:after-swap) y al cargar, así
		  que el tema persiste sin parpadeo. Va is:inline: debe correr antes que
		  el pintado y sobrevivir a los cambios de ruta.
		-->
		<script is:inline>
			(function () {
				var aplicar = function () {
					var raiz = document.documentElement;
					var tema = null;
					var tamano = null;
					try {
						tema = localStorage.getItem('ccd-theme');
						tamano = localStorage.getItem('ccd-text-size');
					} catch (e) {
						/* almacenamiento bloqueado: se respeta el tema por defecto */
					}
					if (tema === 'dark' || tema === 'light') raiz.dataset.theme = tema;
					if (tamano === 'larger' || tamano === 'smaller') raiz.dataset.textSize = tamano;
					else delete raiz.dataset.textSize;
				};
				document.addEventListener('astro:after-swap', aplicar);
				aplicar();
			})();
		</script>
		<ClientRouter />

		<slot name="head" />
	</head>
	<body id="top">
		<a class="skip-link" href="#main-content">Saltar al contenido</a>
		<BlogNavbar />
		<main id="main-content"><slot /></main>
		<SiteFooter>
			<slot name="after-footer" slot="after-footer" />
		</SiteFooter>
	</body>
</html>
