---
import BlogNavbar from '../components/BlogNavbar.astro';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	author?: string;
	publishedDate?: Date;
	image?: string;
	imageAlt?: string;
}

const { title, description, type = 'website', author, publishedDate, image, imageAlt } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<title>{title}</title>
		<SeoHead
			title={title}
			description={description}
			type={type}
			author={author}
			publishedDate={publishedDate}
			image={image}
			imageAlt={imageAlt}
		/>
		<!-- Verificación de Google Search Console: no se quita, aunque la
		     verificación ya esté confirmada, o se pierde. -->
		<meta name="google-site-verification" content="17GfBB6sy7B_3PzGN5E_cDCNievyFX0ndyazf8X0QU0" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<slot name="head" />
	</head>
	<body id="top">
		<a class="skip-link" href="#main-content">Saltar al contenido</a>
		<BlogNavbar />
		<main id="main-content"><slot /></main>
		<SiteFooter>
			<slot name="after-footer" slot="after-footer" />
		</SiteFooter>
	</body>
</html>
